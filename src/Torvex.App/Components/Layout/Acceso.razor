@* Pantalla de acceso obligatorio: iniciar sesión, crear cuenta (con colegio) y espera de aprobación. *@
@implements IDisposable
@inject Cuentas Cuentas

@if (Cuentas.Estado == EstadoAcceso.Carga)
{
    <div class="gate"><div class="gbox"><Marca /><p class="gs" style="text-align:center">Cargando…</p></div></div>
}
else if (Cuentas.Estado == EstadoAcceso.Pendiente)
{
    <div class="espera">
        <div>
            <div class="pulso"><i></i></div>
            <h2>Esperando aprobación</h2>
            <p>El organizador de <b>@Cuentas.ColegioNombre</b> debe darte permiso para entrar. Esta pantalla se actualiza sola.</p>
            <button type="button" class="glink" @onclick="Cuentas.SalirAsync">Cerrar sesión</button>
        </div>
    </div>
}
else
{
    var completar = Cuentas.Estado == EstadoAcceso.Completar;
    var entrar = modo == "login" && !completar;
    <div class="gate">
        <form class="gbox" @onsubmit="Enviar" @onsubmit:preventDefault="true" autocomplete="on">
            <Marca />
            @if (completar)
            {
                <h2 style="margin-top:0">Termina tu registro</h2>
                <p class="gs">Tu cuenta ya existe (@Cuentas.Correo). Falta elegir tu colegio.</p>
            }
            else
            {
                <div class="gtabs" role="tablist">
                    <button type="button" role="tab" class="@(entrar ? "on" : "")" @onclick='() => Cambiar("login")'>Iniciar sesión</button>
                    <button type="button" role="tab" class="@(entrar ? "" : "on")" @onclick='() => Cambiar("crear")'>Crear cuenta</button>
                </div>
            }

            @if (entrar)
            {
                <label class="etq" for="g_email">Correo electrónico</label>
                <input id="g_email" class="campo" type="email" autocomplete="email" placeholder="tu@correo.com" @bind="F.Correo" @bind:event="oninput" />
                <label class="etq" for="g_pass">Contraseña</label>
                <input id="g_pass" class="campo" type="password" autocomplete="current-password" @bind="F.Clave" @bind:event="oninput" />
            }
            else
            {
                @if (!completar)
                {
                    <label class="etq" for="g_nombre">Nombre</label>
                    <input id="g_nombre" class="campo" maxlength="40" autocomplete="name" placeholder="Tu nombre" @bind="F.Nombre" @bind:event="oninput" />
                    <label class="etq" for="g_email2">Correo electrónico</label>
                    <input id="g_email2" class="campo" type="email" autocomplete="email" placeholder="tu@correo.com" @bind="F.Correo" @bind:event="oninput" />
                    <label class="etq" for="g_pass2">Contraseña (mínimo 6)</label>
                    <input id="g_pass2" class="campo" type="password" autocomplete="new-password" @bind="F.Clave" @bind:event="oninput" />
                    <label class="etq" for="g_pass3">Repite la contraseña</label>
                    <input id="g_pass3" class="campo" type="password" autocomplete="new-password" @bind="F.Clave2" @bind:event="oninput" />
                }

                <button type="button" class="interruptor @(F.Organizador ? "on" : "")" aria-pressed="@(F.Organizador ? "true" : "false")" @onclick="AlternarOrganizador">
                    <span class="pista"><i></i></span>
                    <span><b>Organizador</b><small>@(F.Organizador ? "Elige tu colegio o crea uno nuevo" : "Si no lo marcas, necesitas el código de tu colegio")</small></span>
                </button>

                @if (F.Organizador)
                {
                    <label class="etq">Colegio</label>
                    <div class="gdd @(abierto ? "open" : "")">
                        <button type="button" class="gddb" aria-expanded="@(abierto ? "true" : "false")" @onclick="() => abierto = !abierto">
                            <span>@(F.ColegioNuevo ? "➕ Crear un colegio nuevo" : string.IsNullOrEmpty(F.ColegioId) ? "Elige tu colegio" : F.ColegioNombre)</span><i>▾</i>
                        </button>
                        <div class="gddl" role="listbox" inert="@(!abierto)"><div>
                            @if (Cuentas.Colegios.Count == 0) { <p class="gempty">Todavía no hay colegios registrados.</p> }
                            @foreach (var c in Cuentas.Colegios)
                            {
                                <button type="button" role="option" class="@(c.Id == F.ColegioId && !F.ColegioNuevo ? "on" : "")" @onclick="() => ElegirColegio(c)">@c.Nombre</button>
                            }
                            <button type="button" class="gnew" @onclick="NuevoColegio">➕ Mi colegio no está: crear uno nuevo</button>
                        </div></div>
                    </div>
                    @if (F.ColegioNuevo)
                    {
                        <label class="etq" for="g_cnom">Nombre del colegio</label>
                        <input id="g_cnom" class="campo" maxlength="60" autocomplete="off" @bind="F.NuevoColegio" @bind:event="oninput" />
                        <label class="etq" for="g_cclave">Contraseña del colegio (mínimo 6)</label>
                        <input id="g_cclave" class="campo" type="password" autocomplete="new-password" @bind="F.ClaveColegio" @bind:event="oninput" />
                        <p class="gs">Con esta contraseña otros organizadores podrán unirse a tu colegio. Los estudiantes usan el código que verás en Ajustes.</p>
                    }
                    else if (!string.IsNullOrEmpty(F.ColegioId))
                    {
                        <label class="etq" for="g_cclave2">Contraseña del colegio</label>
                        <input id="g_cclave2" class="campo" type="password" autocomplete="off" @bind="F.ClaveColegio" @bind:event="oninput" />
                        <p class="gs">La puso quien creó el colegio.</p>
                    }
                }
                else
                {
                    <label class="etq" for="g_codigo">Código del colegio</label>
                    <input id="g_codigo" class="campo" maxlength="30" autocapitalize="characters" autocomplete="off" placeholder="Ej. SANJ-3F9A27C1" @bind="F.Codigo" @bind:event="oninput" />
                    <p class="gs">Te lo da el organizador de tu colegio.</p>
                }
            }

            @if (!string.IsNullOrEmpty(Cuentas.Error)) { <p class="gerr" role="alert">@Cuentas.Error</p> }

            <button type="submit" class="btn pri lg block gpri" disabled="@Cuentas.Ocupado">
                @(Cuentas.Ocupado ? "Un momento…" : entrar ? "Entrar" : completar ? "Continuar" : "Crear cuenta")
            </button>
            @if (completar) { <button type="button" class="glink" @onclick="Cuentas.SalirAsync">Cerrar sesión</button> }
        </form>
    </div>
}

@code {
    string modo = "login";
    bool abierto;
    FormularioAcceso F = new();

    protected override void OnInitialized() => Cuentas.Cambio += Refrescar;
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => Cuentas.Cambio -= Refrescar;

    void Cambiar(string m) { modo = m; Cuentas.Error = ""; }
    void AlternarOrganizador() { F.Organizador = !F.Organizador; abierto = false; Cuentas.Error = ""; }
    void ElegirColegio(Colegio c) { F.ColegioId = c.Id; F.ColegioNombre = c.Nombre; F.ColegioNuevo = false; abierto = false; Cuentas.Error = ""; }
    void NuevoColegio() { F.ColegioNuevo = true; F.ColegioId = null; F.ColegioNombre = ""; abierto = false; Cuentas.Error = ""; }

    async Task Enviar()
    {
        if (Cuentas.Estado == EstadoAcceso.Completar) await Cuentas.CompletarRegistroAsync(F);
        else if (modo == "login") await Cuentas.IniciarSesionAsync(F.Correo, F.Clave);
        else await Cuentas.CrearCuentaAsync(F);
        if (Cuentas.Estado == EstadoAcceso.Ok) F = new();
    }
}
