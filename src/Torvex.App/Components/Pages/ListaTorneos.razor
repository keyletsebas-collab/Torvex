@page "/torneos"
@implements IDisposable
@inject Cuentas Cuentas
@inject AlmacenTorneos Torneos
@inject NavigationManager Nav

<EncabezadoPagina Titulo="Torneos" Subtitulo="Todas las ediciones por deporte y rama.">
    <Acciones>
        @if (Cuentas.EsOrganizador)
        {
            <button class="btn pri" @onclick="() => nuevo = !nuevo"><Icono Nombre="plus" />Nueva edición</button>
        }
    </Acciones>
</EncabezadoPagina>

<div class="page">
    @if (nuevo)
    {
        <form class="card" @onsubmit="Crear" @onsubmit:preventDefault="true" style="margin-bottom:18px">
            <h3>Nueva edición</h3>
            <label class="etq" for="n_nombre">Nombre</label>
            <input id="n_nombre" class="campo" maxlength="60" placeholder="Ej. Copa de primavera 2026" @bind="nombre" @bind:event="oninput" />
            <div class="cols" style="grid-template-columns:1fr 1fr;gap:12px">
                <div>
                    <label class="etq" for="n_dep">Deporte</label>
                    <select id="n_dep" class="campo" @bind="deporte">
                        @foreach (var d in Deportes.Principales) { <option value="@d.Clave">@d.Icono @d.Nombre</option> }
                    </select>
                </div>
                <div>
                    <label class="etq" for="n_rama">Rama</label>
                    <select id="n_rama" class="campo" @bind="rama">
                        <option value="f">Femenino</option>
                        <option value="m">Masculino</option>
                    </select>
                </div>
            </div>
            <label class="etq" for="n_tipo">Formato</label>
            <select id="n_tipo" class="campo" @bind="tipo">
                <option value="liga">Liga (todos contra todos)</option>
                <option value="elim">Eliminación directa</option>
                <option value="grupos">Grupos y llaves</option>
                <option value="dele">Doble eliminación</option>
            </select>
            <div class="fila fin" style="margin-top:18px">
                <button type="button" class="btn fantasma" @onclick="() => nuevo = false">Cancelar</button>
                <button type="submit" class="btn pri">Crear edición</button>
            </div>
        </form>
    }

    <div class="fila" style="margin-bottom:16px;gap:10px">
        <div class="seg">
            <button class="@(filtroDep == "" ? "on" : "")" @onclick='() => filtroDep = ""'>Todos</button>
            @foreach (var d in Deportes.Principales) { <button class="@(filtroDep == d.Clave ? "on" : "")" @onclick="() => filtroDep = d.Clave">@d.Icono @d.Nombre</button> }
        </div>
        <div class="seg">
            <button class="@(filtroRama == "" ? "on" : "")" @onclick='() => filtroRama = ""'>Ambas</button>
            <button class="@(filtroRama == "f" ? "on" : "")" @onclick='() => filtroRama = "f"'>Femenino</button>
            <button class="@(filtroRama == "m" ? "on" : "")" @onclick='() => filtroRama = "m"'>Masculino</button>
        </div>
        @if (Torneos.Lista.Any(t => t.Arch))
        {
            <button class="btn sm fantasma" @onclick="() => archivados = !archivados">@(archivados ? "Ocultar archivadas" : "Ver archivadas")</button>
        }
    </div>

    @if (!Torneos.Cargado)
    {
        <div class="card vacio">Cargando ediciones…</div>
    }
    else if (Lista.Count == 0)
    {
        <div class="card vacio">
            <div class="vacio-ic"><Icono Nombre="trophy" /></div>
            <b>No hay ediciones</b>
            @(Cuentas.EsOrganizador ? "Crea la primera con «Nueva edición»." : "El organizador todavía no ha creado ediciones.")
        </div>
    }
    else
    {
        <div class="grid-partidos" style="grid-template-columns:repeat(auto-fill,minmax(320px,1fr))">
            @foreach (var t in Lista)
            {
                <a class="card fila" href="torneo/@t.Id" style="color:inherit;align-items:flex-start">
                    <span class="escudo g">@Deportes.De(t.Sport).Icono</span>
                    <span style="flex:1;min-width:0">
                        <b style="font-size:1.05rem">@(string.IsNullOrEmpty(t.Name) ? "Edición sin nombre" : t.Name)</b><br />
                        <span class="hint">@Deportes.De(t.Sport).Nombre · @Nombres.Rama(t.Rama) · @Nombres.Formato(t.Type)</span>
                        <span class="chips">
                            <span class="tag">@t.Teams.Count @(t.Teams.Count == 1 ? "equipo" : "equipos")</span>
                            @if (Clasificacion.Campeon(t) != "") { <span class="tag solido">🏆 @Clasificacion.Campeon(t)</span> }
                            else if (Formatos.Generado(t)) { <span class="tag acento">@Clasificacion.Progreso(t)</span> }
                            else { <span class="tag">Sin partidos</span> }
                            @if (t.Arch) { <span class="tag">Archivada</span> }
                        </span>
                    </span>
                </a>
            }
        </div>
    }
</div>

@code {
    bool nuevo, archivados;
    string nombre = "", deporte = "beis", rama = "f", tipo = "liga";
    string filtroDep = "", filtroRama = "";

    List<Torneo> Lista => Torneos.Lista
        .Where(t => (archivados || !t.Arch) && (filtroDep == "" || t.Sport == filtroDep) && (filtroRama == "" || t.Rama == filtroRama))
        .ToList();

    [SupplyParameterFromQuery(Name = "deporte")] public string? DeporteInicial { get; set; }

    protected override void OnInitialized() => Torneos.Cambio += Refrescar;
    protected override void OnParametersSet() { if (!string.IsNullOrEmpty(DeporteInicial) && filtroDep == "") filtroDep = DeporteInicial; }
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => Torneos.Cambio -= Refrescar;

    void Crear()
    {
        var t = Torneos.Crear(string.IsNullOrWhiteSpace(nombre) ? "Edición " + (Torneos.Lista.Count + 1) : nombre.Trim(), deporte, rama, tipo);
        nuevo = false; nombre = "";
        Nav.NavigateTo("torneo/" + t.Id);
    }
}
