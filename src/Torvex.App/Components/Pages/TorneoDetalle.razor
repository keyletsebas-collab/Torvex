@page "/torneo/{Id:long}"
@implements IDisposable
@inject Cuentas Cuentas
@inject AlmacenTorneos Torneos
@inject Avisos Avisos
@inject NavigationManager Nav

@if (T == null)
{
    <EncabezadoPagina Titulo="Edición" Subtitulo="@(Torneos.Cargado ? "No se encontró esta edición." : "Cargando…")">
        <Acciones><a class="btn fantasma" href="torneos"><Icono Nombre="back" />Torneos</a></Acciones>
    </EncabezadoPagina>
    <div class="page"><div class="card vacio"><div class="vacio-ic"><Icono Nombre="trophy" /></div><b>@(Torneos.Cargado ? "Edición no disponible" : "Cargando…")</b>@(Torneos.Cargado ? "Puede que se haya eliminado." : "")</div></div>
}
else
{
    <EncabezadoPagina Titulo="@(string.IsNullOrEmpty(T.Name) ? "Edición sin nombre" : T.Name)" Subtitulo="@Vista.Etiqueta(T)">
        <Acciones><a class="btn fantasma" href="torneos"><Icono Nombre="back" />Torneos</a></Acciones>
    </EncabezadoPagina>

    <div class="page">
        <div class="chips" style="margin:0 0 6px">
            <span class="tag">@T.Teams.Count @(T.Teams.Count == 1 ? "equipo" : "equipos")</span>
            <span class="tag acento">@Vista.Avance(T)</span>
            @if (T.Arch) { <span class="tag">Archivada</span> }
        </div>

        <div class="tabs" role="tablist">
            <button role="tab" class="@Cls("partidos")" @onclick='() => tab = "partidos"'>Partidos</button>
            <button role="tab" class="@Cls("clasif")" @onclick='() => tab = "clasif"'>Clasificación</button>
            <button role="tab" class="@Cls("equipos")" @onclick='() => tab = "equipos"'>Equipos</button>
            @if (Cuentas.EsOrganizador) { <button role="tab" class="@Cls("opciones")" @onclick='() => tab = "opciones"'>Opciones</button> }
        </div>

        @if (tab == "partidos") { @Partidos() }
        else if (tab == "clasif") { @Clasif() }
        else if (tab == "equipos") { @EquiposTab() }
        else if (tab == "opciones" && Cuentas.EsOrganizador) { @Opciones() }
    </div>
}

@code {
    [Parameter] public long Id { get; set; }
    string tab = "partidos";
    string nuevoEquipo = "";
    string? equipoSel;
    string jNum = "", jNom = "", jPos = "";

    Torneo? T => Torneos.Por(Id);
    string Cls(string k) => tab == k ? "on" : "";
    bool Org => Cuentas.EsOrganizador;

    protected override void OnInitialized() => Torneos.Cambio += Refrescar;
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => Torneos.Cambio -= Refrescar;

    void Guardar() { if (T != null) Torneos.Guardar(T); }

    // ---------------------------------------------------------------- partidos
    sealed record Seccion(string Titulo, List<(string R, int I, Partido M)> Items);

    List<Seccion> Secciones()
    {
        var t = T!; var o = new List<Seccion>();
        static List<(string, int, Partido)> De(string r, List<Partido> l) =>
            l.Select((m, i) => (r, i, m)).Where(x => !Vista.EsDescanso(x.m)).ToList();
        if (t.Type == "liga") o.Add(new("Todos contra todos", De("L", t.Matches)));
        if (t.Type == "grupos") for (var g = 0; g < t.Gr.Count; g++) o.Add(new(t.Gr[g].N, De("G" + g, t.Gr[g].Matches)));
        for (var r = 0; r < t.Rounds.Count; r++) o.Add(new((t.Type == "grupos" ? "Llaves · " : "") + Vista.Ronda(r, t.Rounds.Count), De(r.ToString(), t.Rounds[r])));
        if (t.Tp != null) o.Add(new("Tercer lugar", new() { ("T", 0, t.Tp) }));
        if (t.De != null)
        {
            for (var r = 0; r < t.De.W.Count; r++) o.Add(new("Ganadores · ronda " + (r + 1), De("W" + r, t.De.W[r])));
            for (var r = 0; r < t.De.L.Count; r++) o.Add(new("Perdedores · ronda " + (r + 1), De("L" + r, t.De.L[r])));
            o.Add(new("Gran final", new() { ("F", 0, t.De.F[0]) }));
        }
        return o.Where(s => s.Items.Count > 0).ToList();
    }

    int Minimo => T!.Type switch { "dele" => 3, "grupos" => 4, _ => 2 };

    RenderFragment Partidos() => @<div>
        @if (!Formatos.Generado(T!))
        {
            <div class="card vacio">
                <div class="vacio-ic"><Icono Nombre="calendar" /></div>
                <b>Todavía no hay partidos</b>
                @if (Org)
                {
                    <p>Necesitas al menos @Minimo equipos (tienes @T!.Teams.Count). Súmalos en la pestaña Equipos y sortea los partidos.</p>
                    <button class="btn pri" style="margin-top:16px" disabled="@(T!.Teams.Count < Minimo)" @onclick="() => Generar(false)"><Icono Nombre="bolt" />Generar partidos</button>
                }
                else { <p>El organizador aún no ha generado el calendario.</p> }
            </div>
        }
        else
        {
            @if (Org)
            {
                <div class="fila" style="margin-bottom:6px">
                    @if (T!.Type == "grupos" && T.Rounds.Count == 0)
                    {
                        <button class="btn pri sm" @onclick="GenerarLlaves"><Icono Nombre="trophy" />Generar llaves con los resultados de grupos</button>
                    }
                    <button class="btn sm" @onclick="() => Generar(true)">Volver a sortear</button>
                </div>
            }
            @foreach (var s in Secciones())
            {
                <div class="ronda"><h3>@s.Titulo</h3></div>
                <div class="grid-partidos">
                    @foreach (var x in s.Items) { <FilaPartido T="T!" R="@x.R" I="x.I" M="x.M" /> }
                </div>
            }
        }
    </div>;

    async Task Generar(bool regenerar)
    {
        var t = T!;
        if (t.Teams.Count < Minimo) { Avisos.Toast($"Necesitas al menos {Minimo} equipos."); return; }
        if (regenerar && !await Avisos.ConfirmarAsync("Volver a sortear", "Se sortearán de nuevo los partidos y se perderán los resultados actuales.", "Sortear", true)) return;
        Limpiar(t);
        Formatos.Generar(t);
        Guardar();
        Avisos.Toast("Partidos generados");
    }

    static void Limpiar(Torneo t) { t.Rounds = new(); t.Matches = new(); t.Gr = new(); t.Tp = null; t.De = null; }

    async Task GenerarLlaves()
    {
        var t = T!;
        var pendientes = t.Gr.Any(g => g.Matches.Any(m => m.Est != "cancelado" && !Formatos.Terminado(t, m)));
        if (pendientes && !await Avisos.ConfirmarAsync("Faltan partidos", "Aún hay partidos de grupos sin terminar. ¿Generar las llaves de todas formas?", "Generar")) return;
        Formatos.GenerarLlaves(t);
        Guardar();
        Avisos.Toast("Llaves generadas");
    }

    // ----------------------------------------------------------- clasificación
    RenderFragment TablaHtml(Torneo liga) => @<div class="tabla-w"><table class="tabla">
        <thead><tr><th>#</th><th>Equipo</th><th>PJ</th><th>G</th><th>E</th><th>P</th><th>+</th><th>−</th><th>Dif</th><th>Pts</th></tr></thead>
        <tbody>
            @{ var filas = Clasificacion.Tabla(liga); }
            @for (var i = 0; i < filas.Count; i++)
            {
                var f = filas[i];
                <tr class="@(i == 0 && f.Pj > 0 ? "top" : "")">
                    <td>@(i + 1)</td><td><Escudo Nombre="@f.N" />@f.N</td><td>@f.Pj</td><td>@f.G</td><td>@f.E</td><td>@f.P</td><td>@f.Gf</td><td>@f.Gc</td><td>@(f.Dif > 0 ? "+" : "")@f.Dif</td><td><b>@f.Pt</b></td>
                </tr>
            }
        </tbody></table></div>;

    RenderFragment Clasif() => @<div>
        @{ var c = Clasificacion.Campeon(T!); }
        @if (c != "")
        {
            <div class="campeon">
                <Escudo Nombre="@c" Grande="true" />
                <div><small>Campeón</small><b>🏆 @c</b>
                    @if (Clasificacion.Subcampeon(T!) != "") { <small>Subcampeón: @Clasificacion.Subcampeon(T!)</small> }</div>
            </div>
        }
        @if (!Formatos.Generado(T!)) { <div class="card vacio" style="margin-top:12px"><b>Sin clasificación todavía</b>Se calcula cuando haya partidos jugados.</div> }
        else if (T!.Type == "liga") { <h2>Tabla de posiciones</h2>@TablaHtml(T) }
        else if (T.Type == "grupos")
        {
            @foreach (var g in T.Gr) { <h2>@g.N</h2>@TablaHtml(Vista.ComoLiga(T, g)) }
            @if (T.Rounds.Count == 0) { <p class="hint" style="margin-top:12px">Cuando terminen los grupos, el organizador genera las llaves en la pestaña Partidos.</p> }
        }
        else { <p class="hint" style="margin-top:12px">Este formato se decide por llaves: mira el avance en la pestaña Partidos.</p> }

        @{ var lider = Clasificacion.Estadisticas(T!).Where(x => x.Puntos > 0).OrderByDescending(x => x.Puntos).Take(10).ToList(); }
        @if (lider.Count > 0)
        {
            <h2>Líderes de @Deportes.De(T!.Sport).Unidad.ToLower()</h2>
            <div class="tabla-w"><table class="tabla">
                <thead><tr><th>#</th><th>Jugador</th><th>@Deportes.De(T.Sport).Unidad</th>@if (T.Sport == "vol") { <th>Aces</th><th>Bloq.</th> }</tr></thead>
                <tbody>
                    @for (var i = 0; i < lider.Count; i++)
                    {
                        <tr class="@(i == 0 ? "top" : "")"><td>@(i + 1)</td><td>@lider[i].Jugador <span class="hint">· @lider[i].Equipo</span></td><td><b>@lider[i].Puntos</b></td>
                            @if (T.Sport == "vol") { <td>@lider[i].Aces</td><td>@lider[i].Bloqueos</td> }</tr>
                    }
                </tbody></table></div>
        }
    </div>;

    // ------------------------------------------------------------------ equipos
    bool PuedeEditarPlantilla(string eq) => Org || (Cuentas.Rol == "entrenador" && string.Equals(Cuentas.Perfil?.Equipo, eq, StringComparison.OrdinalIgnoreCase));

    async Task AgregarEquipo()
    {
        var t = T!; var v = nuevoEquipo.Trim();
        if (v == "") return;
        if (t.Teams.Any(x => string.Equals(x, v, StringComparison.OrdinalIgnoreCase))) { Avisos.Toast("Ese equipo ya está en la lista."); return; }
        if (Formatos.Generado(t) && !await Avisos.ConfirmarAsync("Agregar equipo", "Agregar un equipo borra los partidos ya generados y sus resultados. ¿Continuar?", "Agregar", true)) return;
        Limpiar(t);
        t.Teams.Add(v); nuevoEquipo = "";
        Guardar();
    }

    async Task QuitarEquipo(string eq)
    {
        var t = T!;
        if (Formatos.Generado(t) && !await Avisos.ConfirmarAsync("Quitar equipo", "Quitar un equipo borra los partidos ya generados y sus resultados. ¿Continuar?", "Quitar", true)) return;
        Limpiar(t);
        t.Teams.Remove(eq);
        if (equipoSel == eq) equipoSel = null;
        Guardar();
    }

    void AgregarJugador()
    {
        var t = T!; if (equipoSel == null || string.IsNullOrWhiteSpace(jNom)) return;
        var r = t.Roster(equipoSel);
        if (t.Maxp > 0 && r.Pl.Count >= t.Maxp) { Avisos.Toast($"Límite de {t.Maxp} jugadores por equipo."); return; }
        r.Pl.Add(new Jugador { N = jNom.Trim(), Num = jNum.Trim(), Pos = jPos.Trim() });
        jNom = jNum = ""; Guardar();
    }

    void Titular(Jugador j)
    {
        var t = T!; var max = Deportes.De(t.Sport).MaxTitulares; var r = t.Roster(equipoSel!);
        if (!j.St && max > 0 && r.Pl.Count(p => p.St) >= max) { Avisos.Toast($"Ya hay {max} titulares. Pasa a alguien a la banca primero."); return; }
        j.St = !j.St; Guardar();
    }

    RenderFragment EquiposTab() => @<div>
        @if (Org)
        {
            <form class="fila" @onsubmit="AgregarEquipo" @onsubmit:preventDefault="true" style="margin-bottom:16px">
                <input class="campo" maxlength="40" placeholder="Nombre del equipo" aria-label="Nombre del equipo" @bind="nuevoEquipo" @bind:event="oninput" />
                <button type="submit" class="btn pri"><Icono Nombre="plus" />Agregar</button>
            </form>
        }
        @if (T!.Teams.Count == 0)
        {
            <div class="card vacio"><div class="vacio-ic"><Icono Nombre="users" /></div><b>Sin equipos</b>@(Org ? "Agrega los equipos que van a competir." : "Todavía no hay equipos inscritos.")</div>
        }
        else
        {
            <div class="seg" style="margin-bottom:14px">
                @foreach (var eq in T.Teams) { <button class="@(equipoSel == eq ? "on" : "")" @onclick="() => equipoSel = eq">@eq</button> }
            </div>
            @if (equipoSel != null && T.Teams.Contains(equipoSel))
            {
                var r = T.Roster(equipoSel); var puede = PuedeEditarPlantilla(equipoSel); var X = Deportes.De(T.Sport);
                <div class="card">
                    <div class="fila"><Escudo Nombre="@equipoSel" Grande="true" />
                        <div style="flex:1"><h3>@equipoSel</h3><p class="hint">@r.Pl.Count @(r.Pl.Count == 1 ? "jugador" : "jugadores")@(X.MaxTitulares > 0 ? $" · titulares {r.Pl.Count(p => p.St)} de {X.MaxTitulares}" : "")</p></div>
                        @if (Org) { <button class="btn sm peligro" @onclick="() => QuitarEquipo(equipoSel)"><Icono Nombre="trash" />Quitar</button> }
                    </div>
                    <label class="etq" for="coach">Entrenador</label>
                    @if (puede) { <input id="coach" class="campo" maxlength="40" placeholder="Nombre del entrenador" @bind="r.Coach" @bind:after="Guardar" /> }
                    else { <p>@(string.IsNullOrEmpty(r.Coach) ? "Sin entrenador" : r.Coach)</p> }

                    <div class="sep"></div>
                    @if (r.Pl.Count == 0) { <p class="hint">Todavía no hay jugadores.</p> }
                    @foreach (var j in r.Pl.OrderByDescending(p => p.St))
                    {
                        <div class="fila" style="padding:8px 0;border-top:1px solid var(--line)">
                            <b class="num" style="min-width:34px;color:var(--accent)">@(string.IsNullOrEmpty(j.Num) ? "–" : j.Num)</b>
                            <span style="flex:1;min-width:120px"><b>@j.N</b>@if (j.Cap) { <span class="tag acento" style="margin-left:6px">Capitán</span> }<br /><span class="hint">@(string.IsNullOrEmpty(j.Pos) ? "Sin posición" : j.Pos) · @(j.St ? "Titular" : "Banca")</span></span>
                            @if (puede)
                            {
                                <button class="btn sm" @onclick="() => Titular(j)">@(j.St ? "A banca" : "A titular")</button>
                                <button class="btn sm fantasma" aria-label="Quitar a @j.N" @onclick="() => QuitarJugador(j)"><Icono Nombre="trash" /></button>
                            }
                        </div>
                    }
                    @if (puede)
                    {
                        <div class="sep"></div>
                        <form @onsubmit="AgregarJugador" @onsubmit:preventDefault="true">
                            <label class="etq">Agregar jugador</label>
                            <div class="fila">
                                <input class="campo" style="max-width:80px" inputmode="numeric" maxlength="3" placeholder="N.º" aria-label="Número" @bind="jNum" @bind:event="oninput" />
                                <input class="campo" maxlength="40" placeholder="Nombre" aria-label="Nombre del jugador" @bind="jNom" @bind:event="oninput" />
                            </div>
                            <div class="fila" style="margin-top:10px">
                                <select class="campo" aria-label="Posición" @bind="jPos">
                                    <option value="">Posición</option>
                                    @foreach (var p in X.Posiciones) { <option value="@p">@p</option> }
                                </select>
                                <button type="submit" class="btn pri"><Icono Nombre="plus" />Agregar</button>
                            </div>
                        </form>
                    }
                </div>
            }
            else { <p class="hint">Elige un equipo para ver su plantilla.</p> }
        }
    </div>;

    void QuitarJugador(Jugador j) { T!.Roster(equipoSel!).Pl.Remove(j); Guardar(); }

    // ------------------------------------------------------------------ opciones
    string GetTb(int i) => T!.Tb != null && i < T.Tb.Count ? T.Tb[i] : (i == 0 ? "dif" : i == 1 ? "fav" : "");
    void SetTb(int i, string v)
    {
        var t = T!; var tb = (t.Tb is { Count: > 0 } ? t.Tb.ToList() : new List<string> { "dif", "fav" });
        while (tb.Count < 3) tb.Add("");
        tb[i] = v; t.Tb = tb; Guardar();
    }

    async Task Archivar() { T!.Arch = !T.Arch; Guardar(); Avisos.Toast(T.Arch ? "Edición archivada" : "Edición restaurada"); await Task.CompletedTask; }

    async Task Eliminar()
    {
        if (!await Avisos.ConfirmarAsync("Eliminar edición", "No se puede deshacer. Si solo quieres ocultarla, usa Archivar.", "Eliminar", true)) return;
        await Torneos.EliminarAsync(T!);
        Nav.NavigateTo("torneos");
    }

    RenderFragment Opciones() => @<div class="cols" style="grid-template-columns:1fr 1fr;align-items:start">
        <div class="card">
            <h3>General</h3>
            <label class="etq" for="o_nom">Nombre</label>
            <input id="o_nom" class="campo" maxlength="60" @bind="T!.Name" @bind:after="Guardar" />
            <label class="etq" for="o_rama">Rama</label>
            <select id="o_rama" class="campo" @bind="T!.Rama" @bind:after="Guardar">
                <option value="f">Femenino</option><option value="m">Masculino</option><option value="">Sin rama</option>
            </select>
            <label class="etq" for="o_tipo">Formato @(Formatos.Generado(T!) ? "(vuelve a sortear para cambiarlo)" : "")</label>
            <select id="o_tipo" class="campo" disabled="@Formatos.Generado(T!)" @bind="T!.Type" @bind:after="Guardar">
                <option value="liga">Liga (todos contra todos)</option><option value="elim">Eliminación directa</option>
                <option value="grupos">Grupos y llaves</option><option value="dele">Doble eliminación</option>
            </select>
            <label class="etq" for="o_maxp">Máximo de jugadores por equipo (0 = sin límite)</label>
            <input id="o_maxp" class="campo" type="number" min="0" max="40" @bind="T!.Maxp" @bind:after="Guardar" />
            @if (T!.Type is "liga" or "grupos")
            {
                <button type="button" class="interruptor @(T.Dbl ? "on" : "")" @onclick="AlternarIda"><span class="pista"><i></i></span><span><b>Ida y vuelta</b><small>Cada pareja juega dos veces</small></span></button>
            }
            @if (T!.Type is "elim" or "grupos")
            {
                <button type="button" class="interruptor @(T.Third ? "on" : "")" @onclick="AlternarTercero"><span class="pista"><i></i></span><span><b>Partido por el tercer lugar</b><small>Entre los perdedores de semifinales</small></span></button>
            }
        </div>
        <div class="card">
            <h3>Reglas de competencia</h3>
            @if (T!.Type == "grupos")
            {
                <label class="etq" for="o_ng">Número de grupos</label>
                <select id="o_ng" class="campo" disabled="@Formatos.Generado(T!)" @bind="T!.Ng" @bind:after="Guardar">
                    <option value="0">Automático</option><option value="1">1</option><option value="2">2</option><option value="4">4</option>
                </select>
            }
            @if (T!.Type is "elim" or "grupos")
            {
                <label class="etq" for="o_bo">Series de llaves</label>
                <select id="o_bo" class="campo" disabled="@Formatos.Generado(T!)" @bind="T!.Bo" @bind:after="Guardar">
                    <option value="0">Partido único</option><option value="3">Mejor de 3</option><option value="5">Mejor de 5</option><option value="7">Mejor de 7</option>
                </select>
                <label class="etq" for="o_bof">Serie de la final</label>
                <select id="o_bof" class="campo" disabled="@Formatos.Generado(T!)" @bind="T!.BoF" @bind:after="Guardar">
                    <option value="0">Igual que las demás</option><option value="1">Partido único</option><option value="3">Mejor de 3</option><option value="5">Mejor de 5</option><option value="7">Mejor de 7</option>
                </select>
            }
            @if (T!.Type is "liga" or "grupos")
            {
                <div class="fila" style="margin-top:6px">
                    <div style="flex:1"><label class="etq" for="o_pw">Puntos por victoria</label><input id="o_pw" class="campo" type="number" min="0" max="9" value="@(T!.Pw ?? 3)" @onchange="e => { T!.Pw = ParseInt(e.Value); Guardar(); }" /></div>
                    <div style="flex:1"><label class="etq" for="o_pd">Puntos por empate</label><input id="o_pd" class="campo" type="number" min="0" max="9" value="@(T!.Pd ?? 1)" @onchange="e => { T!.Pd = ParseInt(e.Value); Guardar(); }" /></div>
                </div>
                @for (var k = 0; k < 3; k++)
                {
                    var i = k;
                    <label class="etq" for="@("o_tb" + i)">Criterio de desempate @(i + 1)</label>
                    <select id="@("o_tb" + i)" class="campo" value="@GetTb(i)" @onchange="e => SetTb(i, e.Value?.ToString() ?? string.Empty)">
                        @foreach (var c in Clasificacion.Criterios) { <option value="@c.Clave">@c.Nombre</option> }
                    </select>
                }
            }
            @if (T!.Type == "dele") { <p class="hint">La doble eliminación no tiene opciones adicionales: cada equipo queda fuera al perder dos veces.</p> }
        </div>
        <div class="card" style="grid-column:1/-1">
            <h3>Zona de cuidado</h3>
            <div class="fila" style="margin-top:12px">
                <button class="btn" @onclick="Archivar">@(T!.Arch ? "Restaurar edición" : "Archivar edición")</button>
                <button class="btn peligro" @onclick="Eliminar"><Icono Nombre="trash" />Eliminar edición</button>
            </div>
        </div>
    </div>;

    static int ParseInt(object? v) => int.TryParse(v?.ToString(), out var n) ? Math.Clamp(n, 0, 9) : 0;
    void AlternarIda() { T!.Dbl = !T.Dbl; Guardar(); }
    void AlternarTercero() { T!.Third = !T.Third; Guardar(); }
}
