@page "/ajustes"
@implements IDisposable
@inject Cuentas Cuentas
@inject Temas Temas
@inject Avisos Avisos
@inject IJSRuntime JS

<EncabezadoPagina Titulo="Ajustes" Subtitulo="Tu cuenta y la apariencia de la app." />

<div class="page">
    <div class="cols" style="grid-template-columns:1fr 1fr">
        <div>
            <div class="card">
                <div class="fila"><span class="icono-t"><Icono Nombre="palette" /></span><h3>Apariencia</h3></div>
                <p class="hint" style="margin-top:6px">Elige el color base. Toda la app usa tonos de un solo color.</p>
                <label class="etq">Color</label>
                <div class="paletas">
                    @foreach (var p in Temas.Paletas)
                    {
                        <button class="paleta @(Temas.PaletaActual == p.Clave ? "on" : "")" aria-pressed="@(Temas.PaletaActual == p.Clave ? "true" : "false")"
                                @onclick="() => Temas.ElegirPaletaAsync(p.Clave, JS)">
                            <span class="mues">
                                <i style="background:hsl(@p.Tono @(p.Saturacion)% 22%)"></i>
                                <i style="background:hsl(@p.Tono @(p.Saturacion)% 40%)"></i>
                                <i style="background:hsl(@p.Tono @(p.Saturacion)% 66%)"></i>
                                <i style="background:hsl(@p.Tono @(p.Saturacion * 3 / 4)% 90%)"></i>
                            </span>
                            <span>@p.Nombre</span>
                        </button>
                    }
                </div>
                <label class="etq" style="margin-top:20px">Modo</label>
                <div class="seg full">
                    @foreach (var m in Temas.Modos)
                    {
                        <button class="@(Temas.ModoActual == m.Clave ? "on" : "")" @onclick="() => Temas.ElegirModoAsync(m.Clave, JS)">@m.Nombre</button>
                    }
                </div>
            </div>
        </div>

        <div>
            <div class="card">
                <h3>Mi cuenta</h3>
                <div style="margin-top:8px">
                    <div class="dato"><span>Nombre</span><b>@Cuentas.Perfil?.Nombre</b></div>
                    <div class="dato"><span>Correo</span><b>@Cuentas.Correo</b></div>
                    <div class="dato"><span>Colegio</span><b>@Cuentas.ColegioNombre</b></div>
                    <div class="dato"><span>Cargo</span><b>@Nombres.Rol(Cuentas.Rol)@(string.IsNullOrEmpty(Cuentas.Perfil?.Equipo) ? "" : " de " + Cuentas.Perfil!.Equipo)</b></div>
                </div>
                @if (!string.IsNullOrEmpty(Cuentas.Perfil?.Rol))
                {
                    <p class="hint" style="margin-top:6px">@RolDescripcion</p>
                }
                <button class="btn block" style="margin-top:18px" @onclick="Salir"><Icono Nombre="logout" />Cerrar sesión</button>
            </div>

            @if (Cuentas.EsOrganizador)
            {
                <div class="card">
                    <h3>Código del colegio</h3>
                    <p class="hint">Para estudiantes y participantes. Se aprueban en Miembros.</p>
                    <div class="codigo">@(string.IsNullOrEmpty(Cuentas.CodigoColegio) ? "…" : Cuentas.CodigoColegio)</div>
                    <button class="btn" @onclick="Copiar"><Icono Nombre="copy" />Copiar código</button>
                </div>
            }

            <div class="card">
                <h3>Acerca de</h3>
                <div class="dato"><span>Versión</span><b>@AppInfo.Current.VersionString</b></div>
                <div class="dato"><span>Plataforma</span><b>@DeviceInfo.Current.Platform</b></div>
            </div>
        </div>
    </div>
</div>

@code {
    string RolDescripcion => Cuentas.Rol switch
    {
        "organizador" => "Administras ediciones, partidos, equipos y miembros.",
        "anotador" => "Registras marcadores y estadísticas de los partidos.",
        "arbitro" => "Gestionas tus partidos y registras resultados.",
        "entrenador" => "Administras la plantilla de tu equipo.",
        "capitan" => "Confirmas asistencia y armas la alineación de tu equipo.",
        "jugador" => "Juegas en un equipo. Ves todo y no editas marcadores.",
        _ => "Consultas partidos, tablas, equipos y calendario."
    };

    protected override void OnInitialized() { Cuentas.Cambio += Refrescar; Temas.Cambio += Refrescar; }
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() { Cuentas.Cambio -= Refrescar; Temas.Cambio -= Refrescar; }

    async Task Salir()
    {
        if (await Avisos.ConfirmarAsync("Cerrar sesión", "Tendrás que volver a entrar con tu correo y contraseña.", "Cerrar sesión")) await Cuentas.SalirAsync();
    }

    async Task Copiar()
    {
        try { await Clipboard.Default.SetTextAsync(Cuentas.CodigoColegio); Avisos.Toast("Código copiado"); }
        catch { Avisos.Toast("No se pudo copiar"); }
    }
}
