@implements IDisposable
@inject Avisos Avisos

@if (Avisos.Mensaje != null)
{
    <div class="toast" role="status">@Avisos.Mensaje</div>
}
@if (Avisos.Pendiente is { } c)
{
    <div class="modal-fondo" @onclick="() => Avisos.Responder(false)">
        <div class="modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <h3>@c.Titulo</h3>
            <p>@c.Mensaje</p>
            <div class="fila">
                <button class="btn fantasma" @onclick="() => Avisos.Responder(false)">Cancelar</button>
                <button class="btn @(c.Peligro ? "peligro" : "pri")" @onclick="() => Avisos.Responder(true)">@c.TextoOk</button>
            </div>
        </div>
    </div>
}

@code {
    protected override void OnInitialized() => Avisos.Cambio += Refrescar;
    void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => Avisos.Cambio -= Refrescar;
}
