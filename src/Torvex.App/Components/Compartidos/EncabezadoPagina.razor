<header class="topbar">
    <div class="tt">
        <h1>@Titulo</h1>
        @if (!string.IsNullOrEmpty(Subtitulo)) { <p>@Subtitulo</p> }
    </div>
    @Acciones
</header>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }
}
